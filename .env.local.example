# Match the PostgreSQL major version used by the production Lemmy database.
POSTGRES_IMAGE=postgres:17
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ADMIN
VOTE_VIEWER_PASSWORD=CHANGE_ME_LOCAL_VIEWER

# Percent-encode URL-special characters in VOTE_VIEWER_PASSWORD here.
DATABASE_URL=postgresql://vote_viewer:CHANGE_ME_LOCAL_VIEWER@postgres:5432/lemmy

APP_PREFIX=/
PAGE_SIZE=100
LEMMY_BASE_URL=https://example.com
TIMEZONE=Pacific/Auckland
VIEWER_PORT=8080
